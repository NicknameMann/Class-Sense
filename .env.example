# ==============================================================================
# CLASSSENSE ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# PERINGATAN KEAMANAN:
# Seluruh variabel dengan awalan `VITE_` akan diekspos secara publik ke dalam
# client bundle aplikasi web/mobile. JANGAN PERNAH menyimpan kredensial privat,
# password database, atau service account private key di variabel berawalan VITE_.
# ==============================================================================

# 1. Firebase Realtime Database REST API Base URL (Region asia-southeast1)
# Format: https://<instance-name>.asia-southeast1.firebasedatabase.app
VITE_IOT_API_URL=https://classsense-6ef75-default-rtdb.asia-southeast1.firebasedatabase.app

# 2. Firebase Web API Key (Client-side API key untuk Firebase Authentication REST API)
# Diambil dari Firebase Console -> Project Settings -> General -> Web API Key
VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseWebApiKeyHere

